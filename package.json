{
  "name": "math-foundations",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "audit": "tsx scripts/report-inline-audit.ts",
    "content": "tsx scripts/build-android-content.ts",
    "test": "tsx --test scripts/*.test.ts",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check .",
    "pretest": "npm run audit:curriculum",
    "audit:curriculum": "npm run content && tsx scripts/curriculum-inventory.ts"
  },
  "dependencies": {
    "katex": "^0.18.7",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "yaml": "^2.9.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/node": "^26.5.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
